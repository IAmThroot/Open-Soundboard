1 ICON "@ICON_PATH@"

1 VERSIONINFO
FILEVERSION @FILE_VERSION@
PRODUCTVERSION @FILE_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Open Soundboard"
            VALUE "FileDescription", "Open Soundboard"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "open-soundboard"
            VALUE "LegalCopyright", "Open Soundboard Contributors"
            VALUE "OriginalFilename", "open-soundboard.exe"
            VALUE "ProductName", "Open Soundboard"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
